{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:openjdk.org)",
      "Bash(curl -sL -A Mozilla/5.0 https://openjdk.org/projects/jdk/__TRACKED_VAR__/)",
      "Bash(curl -sL -m 15 -A \"Mozilla/5.0\" -o /tmp/jdk26.html -w \"HTTP %{http_code}, %{size_download} bytes\\\\n\" \"https://openjdk.org/projects/jdk/26/\")",
      "Read(//tmp/**)",
      "Bash(curl -sL -m 20 -A \"Mozilla/5.0\" \"https://openjdk.org/projects/jdk/26/\" -o /tmp/j26.html)",
      "Bash(git add *)",
      "Bash(git -c 'user.name=Java Feature Docs' -c user.email=you@example.com commit -q -m ' *)"
    ]
  }
}
